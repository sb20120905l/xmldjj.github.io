/* 页面特有样式，全局样式已在 app.wxss 定义 */
.header {
  margin-bottom: 40rpx;
}
.logo-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.logo-icon {
  font-size: 60rpx;
  filter: drop-shadow(0 0 12rpx #00ffaa);
  animation: pulseGlow 3s infinite;
}
.logo-text {
  font-size: 52rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #fff, #b0ffd0);
  -webkit-background-clip: text;  /* 保留 */
  background-clip: text;          /* 新增标准属性 */
  -webkit-text-fill-color: transparent;
  color: transparent;              /* 可选，同时设置文字颜色透明 */
  letter-spacing: 2rpx;
}
.slogan {
  font-size: 24rpx;
  color: #a0b8d4;
  letter-spacing: 2rpx;
  margin-left: 8rpx;
  margin-bottom: 20rpx;
}
.online-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(0, 255, 170, 0.1);
  backdrop-filter: blur(10px);
  padding: 8rpx 30rpx 8rpx 24rpx;
  border-radius: 60rpx;
  border: 1rpx solid #00ffaa40;
  font-size: 26rpx;
  color: #ccffee;
}
.pulse-dot {
  width: 16rpx;
  height: 16rpx;
  background: #00ffaa;
  border-radius: 50%;
  margin-right: 16rpx;
  box-shadow: 0 0 10rpx #00ffaa;
  animation: pulseGlow 1.5s infinite;
}
.range-card {
  background: rgba(20, 30, 45, 0.7);
  backdrop-filter: blur(20px);
  border-radius: 40rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #2e4a5a;
  box-shadow: 0 20rpx 30rpx rgba(0,0,0,0.6);
}
.range-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 28rpx;
}
.range-badge {
  font-size: 22rpx;
  background: #1e3a3a;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  color: #9effaa;
}
.tag-group {
  display: flex;
  gap: 30rpx;
}
.game-tag {
  background: rgba(0, 255, 170, 0.08);
  border: 1rpx solid #00ffaa30;
  padding: 16rpx 40rpx 16rpx 30rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #e0f2fe;
  backdrop-filter: blur(5px);
  transition: all 0.2s;
}
.game-tag:active {
  background: #00ffaa20;
  transform: scale(0.97);
}
.tag-icon {
  margin-right: 16rpx;
  font-size: 40rpx;
}
.game-swiper {
  width: 100%;
  margin-bottom: 50rpx;
}
.game-card {
  border-radius: 48rpx;
  padding: 30rpx 36rpx 30rpx 30rpx;
  display: flex;
  gap: 30rpx;
  height: 100%;
  box-sizing: border-box;
  transition: transform 0.2s, border-color 0.2s;
}
.game-card:active {
  transform: scale(0.99);
  border-color: #00ffaa;
}
.card-left {
  flex-shrink: 0;
}
.icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: bold;
  color: #d0f0ff;
  border: 2rpx solid #00ffaa60;
  box-shadow: 0 0 30rpx #00ffaa20;
}
.card-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.game-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin-bottom: 8rpx;
  text-shadow: 0 0 10rpx #00ffaa50;
}
.game-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #b0c7e7;
  margin-bottom: 20rpx;
}
.price {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffd966;
  background: #1e3a2e;
  padding: 4rpx 20rpx;
  border-radius: 50rpx;
}
.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.status-badge {
  font-size: 26rpx;
  background: #1a4a3a;
  padding: 8rpx 28rpx;
  border-radius: 50rpx;
  color: #9effb4;
  border: 1rpx solid #00ffaa;
}
.order-btn {
  background: linear-gradient(145deg, #00cc88, #009966);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 60rpx;
  padding: 0 30rpx;
  height: 70rpx;
  line-height: 70rpx;
  border: none;
  box-shadow: 0 8rpx 0 #006644;
  transition: all 0.1s ease;
}
.order-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #006644;
}
.btn-hover {
  opacity: 0.8;
  transform: scale(0.96);
}
.features-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 40rpx 0 50rpx;
  gap: 20rpx;
}
.feature-item {
  background: rgba(20, 35, 50, 0.6);
  backdrop-filter: blur(8px);
  border: 1rpx solid #2e4a5a;
  border-radius: 30rpx;
  width: calc(25% - 16rpx);
  min-width: 140rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #ccf2ff;
  transition: all 0.2s;
}
.feature-item:active {
  background: #1e3a4a;
  border-color: #00ffaa;
}
.feature-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
  filter: drop-shadow(0 0 8rpx #00ffaa);
}
.action-bar {
  display: flex;
  gap: 30rpx;
  margin: 40rpx 0 30rpx;
}
.action-btn {
  flex: 1;
  height: 90rpx;
  border-radius: 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(30, 45, 65, 0.9);
  backdrop-filter: blur(10px);
  border: 1rpx solid #3e5a6a;
  color: #f0f9ff;
  box-shadow: 0 8rpx 0 #0f1a24;
  transition: all 0.1s;
}
.action-btn.contact {
  background: linear-gradient(145deg, #2a3f5a, #1b2a3a);
}
.action-btn.book {
  background: linear-gradient(145deg, #006b4f, #003d2e);
  border-color: #00cc88;
  color: #e6fff0;
}
.action-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 0 #0f1a24;
}
.footer {
  text-align: center;
  font-size: 24rpx;
  color: #6a7e9e;
  padding: 30rpx 0 10rpx;
}

/* 技术支持提示（新增） */
.tech-support {
  position: fixed;
  left: 30rpx;
  bottom: 30rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  color: #00ffaa;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  border: 1rpx solid #00ffaa40;
  z-index: 1000;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.5s ease, transform 0.5s ease;
  pointer-events: none;
}
.tech-support.show {
  opacity: 1;
  transform: translateY(0);
}