.container {
  height: 100vh;
}

/* 主图占位 */
.detail-img-placeholder {
  width: 100%;
  height: 400rpx;
  background-color: #e8f4ff;
  color: #1677ff;
  text-align: center;
  line-height: 400rpx;
  font-size: 40rpx;
}

/* 套餐信息 */
.info {
  padding: 20rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}
.info-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.info-price {
  color: #f53f3f;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.info-desc {
  font-size: 28rpx;
  color: #666;
}

/* 规格选择 */
.spec {
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.spec-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.spec-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.spec-item {
  padding: 15rpx 20rpx;
  border: 1px solid #eee;
  border-radius: 8rpx;
}
.spec-item.active {
  border-color: #1677ff;
  color: #1677ff;
  background-color: #e8f4ff;
}

/* 表单 */
.form {
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.form-label {
  font-size: 28rpx;
  width: 120rpx;
}
.form-input {
  flex: 1;
  border: 1px solid #eee;
  padding: 15rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 底部下单栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 100rpx;
  line-height: 100rpx;
  border-top: 1px solid #eee;
  background-color: #fff;
}
.cart-btn {
  flex: 1;
  background-color: #fff;
  color: #1677ff;
  border: 1px solid #1677ff;
  border-radius: 0;
  font-size: 32rpx;
}
.buy-btn {
  flex: 1;
  background-color: #1677ff;
  color: #fff;
  border: none;
  border-radius: 0;
  font-size: 32rpx;
}