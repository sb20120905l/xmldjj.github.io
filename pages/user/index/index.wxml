<view class="page">
  <view class="profile-card animate-fade-down">
    <view class="avatar">🐟</view>
    <view class="user-info">
      <text class="nickname">黑鱼丶玩家</text>
      <text class="level">VIP3 · 累计消费 ¥1250</text>
    </view>
  </view>

  <view class="menu-list animate-fade-up">
    <view class="menu-item" wx:for="{{menus}}" wx:key="index" bindtap="gotoPage" data-url="{{item.url}}">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-text">{{item.name}}</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>