.container {
  padding: 20rpx;
  padding-bottom: 100rpx;
}

/* 筛选栏 */
.filter {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.filter-item {
  flex: 1;
  background-color: #fff;
  padding: 15rpx;
  text-align: center;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

/* 套餐列表 */
.package-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.package-item {
  display: flex;
  gap: 20rpx;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}
.package-img-placeholder {
  width: 180rpx;
  height: 180rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  line-height: 180rpx;
  color: #666;
}
.package-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.package-name {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}
.package-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.package-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.package-price {
  color: #f53f3f;
  font-size: 32rpx;
  font-weight: bold;
}
.package-btn {
  background-color: #1677ff;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
}