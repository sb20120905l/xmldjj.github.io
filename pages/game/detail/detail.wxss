.game-header {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin: 30rpx 0 50rpx;
  background: rgba(20,30,45,0.7);
  backdrop-filter: blur(10px);
  border-radius: 40rpx;
  padding: 40rpx;
}
.icon-large {
  font-size: 120rpx;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(145deg, #2a3a5a, #0e1a2b);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #00ffaa60;
}
.title-area {
  display: flex;
  flex-direction: column;
}
.game-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
}
.game-desc {
  font-size: 28rpx;
  color: #b0c7e7;
}
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #9effb4;
  display: block;
  margin-bottom: 30rpx;
}
.price-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 50rpx;
}
.price-item {
  background: rgba(0,255,170,0.1);
  border: 1rpx solid #00ffaa40;
  border-radius: 30rpx;
  padding: 20rpx 30rpx;
  min-width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: 0.2s;
}
.price-item:active {
  background: #00ffaa20;
  transform: scale(0.96);
}
.price-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffd966;
  margin-top: 10rpx;
}
.coach-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 120rpx;
}
.coach-card {
  display: flex;
  align-items: center;
  background: rgba(30,45,65,0.7);
  backdrop-filter: blur(8px);
  border-radius: 30rpx;
  padding: 20rpx;
  border: 1rpx solid #2e4a5a;
}
.coach-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #3a4a6a;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.coach-info {
  display: flex;
  flex-direction: column;
}
.coach-name {
  font-size: 32rpx;
  font-weight: 600;
}
.coach-stats {
  font-size: 24rpx;
  color: #a0b8d4;
}
.action-bar-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(10,15,25,0.9);
  backdrop-filter: blur(20px);
  padding: 20rpx 30rpx 40rpx;
  border-top: 1rpx solid #2e4a5a;
}
.action-bar-fixed .action-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(145deg, #006b4f, #003d2e);
  border-color: #00cc88;
  color: #e6fff0;
  border-radius: 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 0 #003d2e;
}
.action-bar-fixed .action-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 0 #003d2e;
}