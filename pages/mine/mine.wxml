<view class="container">
  <!-- 个人信息 -->
  <view class="user-info">
    <view class="avatar-placeholder">👤</view>
    <view class="user-text">
      <text class="user-name">游客用户</text>
      <text class="user-tip">点击登录/注册</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="func-list">
    <view class="func-item" bindtap="goToOrderList">
      <text class="func-icon">📝</text>
      <text class="func-text">我的订单</text>
      <text class="func-arrow">＞</text>
    </view>
    <view class="func-item">
      <text class="func-icon">🎫</text>
      <text class="func-text">我的优惠券</text>
      <text class="func-arrow">＞</text>
    </view>
    <view class="func-item">
      <text class="func-icon">🎮</text>
      <text class="func-text">常用游戏账号</text>
      <text class="func-arrow">＞</text>
    </view>
    <view class="func-item" bindtap="contactService">
      <text class="func-icon">📞</text>
      <text class="func-text">联系客服</text>
      <text class="func-arrow">＞</text>
    </view>
    <view class="func-item" bindtap="goToData">
      <text class="func-icon">📊</text>
      <text class="func-text">商家数据中心</text>
      <text class="func-arrow">＞</text>
    </view>
    <view class="func-item">
      <text class="func-icon">ℹ️</text>
      <text class="func-text">关于我们</text>
      <text class="func-arrow">＞</text>
    </view>
  </view>
</view>