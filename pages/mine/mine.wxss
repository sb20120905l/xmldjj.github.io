.container {
  padding-bottom: 100rpx;
  background-color: #f5f5f5;
}

/* 个人信息 */
.user-info {
  display: flex;
  align-items: center;
  background-color: #1677ff;
  color: white;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}
.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background-color: white;
  color: #1677ff;
  border-radius: 50%;
  margin-right: 20rpx;
  font-size: 50rpx;
}
.user-name {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 5rpx;
}
.user-tip {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 功能列表 */
.func-list {
  background-color: #fff;
}
.func-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1px solid #eee;
  font-size: 30rpx;
}
.func-icon {
  margin-right: 20rpx;
  font-size: 32rpx;
}
.func-text {
  flex: 1;
}
.func-arrow {
  color: #999;
  font-size: 28rpx;
}